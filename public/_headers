# riffrolled — security headers for the static assets.
#
# These apply ONLY to files served from public/. Responses generated by the
# Worker (everything under /api/*) set their own headers in
# src/utils/response.js — Cloudflare does not apply this file to them.
#
# The policy below is strict because it can afford to be: riffrolled has no
# inline <script>, no inline event handlers and no style="" attributes in its
# markup, so neither script-src nor style-src needs 'unsafe-inline'. That is
# what makes CSP worth having here — with 'unsafe-inline' it stops almost
# nothing. Every wallet key lives in this browser, so the point of the policy
# is that a future escaping mistake stays inert instead of becoming a key
# theft.
#
# Setting el.style.left in JavaScript is CSSOM, not an inline style, and is
# unaffected. What WOULD break is adding a style="" attribute inside an
# innerHTML string, or an inline <script> to index.html — don't.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://www.youtube.com https://s.ytimg.com; style-src 'self'; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com; font-src 'self'; connect-src 'self' https://www.youtube.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Why each exception exists, so nobody widens one by guessing:
#   cdn.jsdelivr.net   Dexie
#   www.youtube.com    the IFrame API script, the player frame, and oEmbed
#                      link checks (connect-src)
#   s.ytimg.com        www-widgetapi.js, which YouTube's own script pulls in
#   i.ytimg.com        video thumbnails
#   data:              the inline SVG favicon
#   blob: (worker-src) the mining Web Worker, built from a string literal
#   same-origin-allow-popups  the "open in ChatGPT/Claude/Gemini" buttons
#
# frame-ancestors 'none' means riffrolled can't be framed by anyone, which
# also rules out clickjacking the promote and mine buttons.

# The service worker must not be cached, or a stale one outlives a deploy.
/sw.js
  Cache-Control: no-cache
  Content-Type: text/javascript; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
