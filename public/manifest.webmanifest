{
  "name": "riffrolled",
  "short_name": "riffrolled",
  "description": "A record deck for discovering music on YouTube.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b17",
  "theme_color": "#0b0b17",
  "orientation": "any",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
